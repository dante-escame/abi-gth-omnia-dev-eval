    {
      "_id": "req_auth_login",
      "_type": "request",
      "parentId": "grp_auth",
      "name": "POST Login",
      "description": "Authenticates by e-mail and password and returns a JWT.\n\nRate limited by the `Login` policy — repeated failures return 429.\n\n200 body: `{ success, message, data: { token, email, name, role }, errors }`\n400 invalid request - 401 bad credentials - 429 too many attempts\n\nThe after-response script writes `data.token` into the `token` environment variable.",
      "method": "POST",
      "url": "{{ _.baseUrl }}/api/Auth",
      "parameters": [],
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "authentication": {},
      "metaSortKey": -999998000,
      "isPrivate": false,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"admin@developerstore.com\",\n  \"password\": \"Str0ng!Pass\"\n}"
      },
      "afterResponseScript": "const body = insomnia.response.json();\nif (body && body.data && body.data.token) {\n  insomnia.environment.set('token', body.data.token);\n}\n"
    },
