      "name": "02 Register the customer",
      "description": "Expects 201. The email and username are generated per send, so this is safe to repeat. Later steps read the email back out of this response.",
      "method": "POST",
      "url": "{{ _.baseUrl }}/api/users",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"customer-{% uuid 'v4' %}@example.test\",\n  \"username\": \"customer-{% uuid 'v4' %}\",\n  \"password\": \"{{ _.password }}\",\n  \"name\": {\n    \"firstname\": \"Walkthrough\",\n    \"lastname\": \"Runner\"\n  },\n  \"address\": {\n    \"city\": \"Sao Paulo\",\n    \"street\": \"Rua Um\",\n    \"number\": 42,\n    \"zipcode\": \"01000-000\",\n    \"geolocation\": {\n      \"lat\": \"-23.5\",\n      \"long\": \"-46.6\"\n    }\n  },\n  \"phone\": \"+5511987654321\",\n  \"status\": \"Active\",\n  \"role\": \"Customer\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "authentication": {},
      "parameters": [],
      "pathParameters": [],
      "metaSortKey": 2000,
      "isPrivate": false,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global",
      "afterResponseScript": "const res = insomnia.response;\nif (res.code >= 200 && res.code < 300) {\n    const json = res.json();\n    insomnia.baseEnvironment.set('customerEmail', json.email);\n}\n"
    },
